{
  "name": "@remem/mcp-server",
  "version": "2.0.0",
  "mcpName": "io.github.remem-mcp/mcp-server",
  "description": "An MCP server for logging daily activities, tracking time, generating daily, weekly and monthly reports, and long-term reflection. Includes a local web dashboard.",
  "type": "module",
  "main": "./build/index.js",
  "bin": {
    "remem": "build/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/remem-mcp/mcp-server"
  },
  "files": [
    "build/**/*.js",
    "build/**/*.json",
    "build/web/public/**",
    "README.md",
    "README.ja.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "watch": "tsc -w",
    "start": "node build/index.js",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "ui": "node build/index.js ui"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "sqlite",
    "productivity",
    "log",
    "daily-report",
    "weekly-report",
    "time-tracking",
    "dashboard"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "better-sqlite3": "^12.6.0",
    "i18next": "^27.2.9",
    "kysely": "^0.28.9",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.5",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
